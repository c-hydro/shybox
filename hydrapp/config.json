{
  "title": "SHYBOX \u00b7 Hydrological dashboard",
  "default_run": "marche_deterministic",
  "missing_values": [
    -9999,
    -9998
  ],
  "overview": {
    "period": "all",
    "probability_cutoff": 0.5
  },
  "runs": {
    "marche_deterministic": {
      "name": "Marche \u00b7 Deterministic",
      "enabled": true,
      "mode": "deterministic",
      "time_series": {
        "folder": "../exec/case_study_marche/analyzer_hmc/data/time_series",
        "file_pattern": "**/hmc.series_*.nc",
        "run_time_regex": "(?P<time>\\d{12})\\.nc$",
        "run_time_format": "%Y%m%d%H%M"
      },
      "maps": {
        "enabled": false,
        "variables": [
          "soil_moisture",
          "discharge"
        ]
      }
    },
    "marche_probabilistic": {
      "name": "Marche \u00b7 Probabilistic",
      "enabled": true,
      "mode": "probabilistic",
      "ensemble_dimension": "ensemble",
      "quantiles": [
        0.05,
        0.25,
        0.5,
        0.75,
        0.95
      ],
      "time_series": {
        "folder": "../exec/case_study_marche/analyzer_hmc/data/time_series_ensemble",
        "file_pattern": "**/hmc.series_*.nc",
        "run_time_regex": "(?P<time>\\d{12})\\.nc$",
        "run_time_format": "%Y%m%d%H%M"
      },
      "maps": {
        "enabled": false,
        "variables": [
          "soil_moisture",
          "discharge"
        ]
      }
    }
  },
  "monitoring": {
    "folder": "../exec/monitoring",
    "stale_seconds": 180,
    "applications": {
      "marche_hmc": {
        "name": "Marche \u00b7 Continuum",
        "run_name": "nwp_icon_marche",
        "application": "hmc",
        "run_domain": "marche",
        "run_mode": "deterministic"
      },
      "marche_hmc_ensemble": {
        "name": "Marche \u00b7 Continuum ensemble",
        "run_name": "nwp_icon_marche",
        "application": "hmc",
        "run_domain": "marche",
        "run_mode": "probabilistic",
        "ensemble_members": [
          1,
          2,
          3,
          4,
          5
        ]
      }
    }
  },
  "publications": {
    "enabled": true,
    "folder": "demo/figures"
  }
}
