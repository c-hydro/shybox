{
  "__comment__": "configuration file for the datasets information",
  "configuration": {
    "priority": {
      "reference": "environment", "other": "user"
    },
    "flags": {
      "update_namelist": true, "update_execution": true
    },
    "variables": {
      "lut": {
        "user": {
          "time_run": "2026-08-18 04:33",
          "file_log": "{execution_name}_{domain_name}.log",
          "execution_name": "geo_hmc_watersheds", "execution_mode": "static"
        },
        "environment": {
          "domain_name": "DOMAIN_NAME",
          "path_base_src": "PATH_SRC_BASE",
          "path_base_dst": "PATH_DST_BASE",
          "path_app": "PATH_APP",
          "path_log": "PATH_LOG", "path_tmp": "PATH_TMP"
        }
      },
      "format": {
        "domain_name": "string", "time_run": "string",
        "path_base_src": "string", "path_base_dst": "string",
        "path_app": "string",
        "path_log": "string", "file_log": "string",
        "path_tmp": "string",
        "execution_name": "string", "execution_mode": "string"
      },
      "template": {
        "domain_name": "string", "time_run": "string",
        "path_base_src": "string", "path_base_dst": "string",
        "path_app": "string",
        "path_log": "string", "file_log": "string",
        "path_tmp": "string",
        "execution_name": "string", "execution_mode": "string"
      }
    }
  },
  "application": {
    "time": {
      "start": null,
      "end": null,
      "frequency": "H",
      "format": "%Y-%m-%d %H:%M",
      "analysis": null,
      "dataset": null
    },
    "geo_data_src": {
      "registry_sections": {
        "path": "{path_base_src}/sections/",
        "file_name": "fp_sections_marche.csv",
        "lut_map": {
          "id": "ID", "section_code": "SEC_CODE", "section_type": "TYPE", "section_name": "SEC_NAME",
          "station_name": "SEC_RS", "station_code": "SEC_RS", "catchment_name": "BASIN",
          "data_from": "SEC_TAG", "tag": "SEC_TAG", "domain_name": "DOMAIN",
          "municipality": "ADMIN_B_L1", "province": "ADMIN_B_L2",  "region": "ADMIN_B_L3",
          "basin": "BASIN", "longitude": "LON", "latitude": "LAT", "catchment_area_km2": "AREA",
          "discharge_yellow": "Q_THR1", "discharge_orange": "Q_THR2", "discharge_red": "Q_THR3",
          "threshold_level_1": "Q_THR1", "threshold_level_2": "Q_THR2", "threshold_level_3": "Q_THR3",
          "section_baseflow": "BASEFLOW", "x": "HMC_X", "y": "HMC_Y"},
        "lut_type": {
          "tag": "str", "id": "int", "section_name": "str",
          "station_name": "str", "catchment_name": "str",
          "data_from": "str", "domain_name": "str",
          "municipality": "str", "province": "str", "region": "str",  "basin": "str",
          "longitude": "np.float64", "latitude": "np.float64", "catchment_area_km2": "float",
          "threshold_level_1": "float", "threshold_level_2": "float", "threshold_level_3": "float",
          "discharge_yellow": "float", "discharge_orange": "float", "discharge_red": "float",
          "x": "int", "y": "int"
        }
      },
      "flow_directions": {
        "path": "{path_base_src}/maps/src/",
        "file_name": "marche.pnt.txt"
      },
      "channels_network": {
        "path": "{path_base_src}/maps/src/",
        "file_name": "marche.choice.txt"
      }
    },
    "geo_data_dst": {
      "path": "{path_base_dst}/maps/dst/",
      "file_name": "mask.{section_name}_watershed.tiff",
      "format": "tiff",
      "type": null,
      "mode": "mask",
      "units": {},
      "dims_data": {"x": "longitude", "y": "latitude"},
      "vars_data": {
        "mask": "watershed_mask"
      }
    }
  },
  "workflow": {
    "options": {
        "intermediate_output": "Tmp",
        "tmp_dir": "{path_tmp}"
    },
    "process_list": {
        "WATERSHEDS": [
            {"function": "delineate_watershed", "fill_value": -9999, "no_data_value": -9999}
        ]
    }
  },
  "log": {
    "path": "{path_log}/{domain_name}", "file_name": "geo_watersheds_hmc.txt",
    "handlers": ["file","stream"]
  },
  "tmp": {
    "path": "{path_tmp}/{domain_name}",
    "file_name": null
  }
}
