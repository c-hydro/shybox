      "file_name": "hmc.rt.{file_destination_time}.tiff",
      "format": "geotiff",
      "type": null,
      "mode": "grid",
      "variable": "discharge",
      "dims_geo": {"longitude": "longitude", "latitude": "latitude"},
      "vars_geo": {"longitude": "longitude", "latitude": "longitude"},
      "vars_data": {"discharge_to_rt": "return_time"}
    }
  },
  "workflow": {
    "options": {
        "intermediate_output": "Tmp",
        "tmp_dir": "{path_tmp}"
    },
    "process_list": {
        "RETURN_TIME": [
            {"function": "compute_return_time", "method": "nn", "max_distance": 25000, "neighbours": 7,
             "fill_value": null, "var_no_data": 0,
              "thr_discharge_min_flag": true, "thr_discharge_min_value": 6.0
            }
        ]
    }
  },
  "log": {
    "path": "{path_log}",
    "file_name": "merger_by_domain_hmc_rt.txt"
  },
  "tmp": {
