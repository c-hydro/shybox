{
  "__comment__": "configuration file for the datasets information",
  "configuration": {
    "priority": {
      "reference": "environment", "other": "user"
    },
    "flags": {
      "update_namelist": true, "update_execution": true
    },
    "variables": {
      "lut": {
        "user": {
          "path_time_source": null, "path_time_destination": null,
          "time_rounding": "H", "time_frequency": "H",  "time_direction": "forward",
          "time_start_rounding": "H", "time_end_rounding": "H",
          "file_log": "{execution_name}_{domain_name}.log",
          "execution_name": "converter_points2grid", "execution_mode": "history"
        },
        "environment": {
          "domain_name": "DOMAIN_NAME",
          "path_geo": "PATH_GEO",
          "path_dynamic_source": "PATH_SRC", "path_dynamic_destination": "PATH_DST",
          "file_time_source_ground": "TIME_RUN", "file_time_source_s3m": "TIME_RUN",
          "file_time_destination": "TIME_RUN",
          "time_run": "TIME_RUN", "time_period" : "TIME_PERIOD",
          "time_start": "TIME_START", "time_end": "TIME_END",
          "path_app": "PATH_APP",
          "path_log": "PATH_LOG", "path_tmp": "PATH_TMP"
        }
      },
      "format": {
        "domain_name": "string",
        "path_geo": "string",
        "path_dynamic_source": "string", "path_dynamic_destination": "string",
        "path_time_source": "string", "path_time_destination": "string",
        "file_time_source_ground": "timestamp",  "file_time_source_s3m": "timestamp",
        "file_time_destination": "timestamp",
        "time_direction": "string", "time_run": "string",
        "time_start": "string", "time_end": "string",
        "time_period": "int", "time_rounding": "string", "time_frequency": "string",
        "time_start_rounding": "string", "time_end_rounding": "string",
        "path_app": "string",
        "path_log": "string", "file_log": "string",
        "path_tmp": "string",
        "execution_name": "string", "execution_mode": "string"
      },
      "template": {
        "domain_name": "string",
        "path_geo": "string",
        "path_dynamic_source": "string", "path_dynamic_destination": "string",
        "path_time_source": "%Y/%m/%d", "path_time_destination": "%Y/%m/%d/",
        "file_time_source_ground": "%Y%m%d", "file_time_source_s3m": "%Y%m%d%H00",
        "file_time_destination": "%Y%m%d%H00",
        "time_direction": "string", "time_run": "%Y%m%d%H00",
        "time_start": "%Y%m%d%H00", "time_end": "%Y%m%d%H00",
        "time_period": "int", "time_rounding": "string", "time_frequency": "string",
        "time_start_rounding": "string", "time_end_rounding": "string",
        "path_app": "string",
        "path_log": "string", "file_log": "string",
        "path_tmp": "string",
        "execution_name": "string", "execution_mode": "string"
      }
    }
  },
  "application": {
    "time": {
      "start": "{time_start}",
      "end": "{time_end}",
      "frequency": "H",
      "format": "%Y-%m-%d %H:%M",
      "analysis": "{time_period}",
      "dataset": "{time_period}"
    },
    "static_data": {
      "raster_terrain": {
        "path": "{path_geo}/",
        "file_name": "vda.dem.txt"
      },
      "raster_monte_bianco": {
        "path": "{path_geo}/",
        "file_name": "mbianco_WGS84_resampled.tif"
      },
      "raster_monte_paradiso": {
        "path": "{path_geo}/",
        "file_name": "mparadiso_WGS84_resampled.tif"
      },
      "raster_inverse_combin": {
        "path": "{path_geo}/",
        "file_name": "inverse_mcombin_WGS84_resampled.tif"
      },
      "raster_forest": {
        "path": "{path_geo}/",
        "file_name": "tcd_2018_32632_vda_resampled_mean_240m_WGS84.tif"
      }
    },
    "dynamic_data_src": {
      "ground": {
        "path": "{path_dynamic_source}/ground/{path_time_source}/",
        "file_name": "HS_{file_time_source_ground}.csv",
        "format": "csv"
      },
      "viirs_snow_cover_area": {
        "path": "{path_dynamic_source}/viirs/{path_time_source}/",
        "file_name": "CGF_NDSI_Snow_Cover_SCA_S3M.tif",
        "format": "tif"
      },
      "viirs_cloud_persistence": {
        "path": "{path_dynamic_source}/viirs/{path_time_source}/",
        "file_name": "Cloud_Persistence.tif",
        "format": "tif"
      },
      "s3m": {
        "path": "{path_dynamic_source}/s3m/{path_time_source}/",
        "file_name": "SnowHeight_{file_time_source_s3m}.tif",
        "format": "tif"
      }

    },
    "dynamic_data_dst": {
      "path": "{path_dynamic_destination}/{path_time_destination}/",
      "file_name": "snow_data_{file_time_destination}.nc",
      "format": "netcdf", "type": "default"
    }
  },
  "workflow": {
    "options": {
        "intermediate_output": "Tmp",
        "tmp_dir": "{path_tmp}",
        "io_config": {"mode": "many_data_variables_to_one_file"}
    },
    "process_list": {
        "SNOW_HEIGHT_WORKFLOW": [
          {
            "function": "exec_interpolate_points_hs",
            "datasets": {
              "points_hs": "ground_snow_height",
              "satellite_sca": "snow_cover_area",
              "satellite_cp": "cloud_persistence",
              "s3m_hs": "s3m_snow_height"
            },
            "results": {
              "result_sca": "snow_cover_area",
              "result_sqa": "snow_quality_area",
              "result_kernel": "kernel",
              "result_snow_height": "snow_height"
            },
            "fill_value": -9999, "no_data_value": -9999,
            "S3M_iFlagSCA_regrid": 1, "S3M_threshold_cloud_per": 3,
            "S3M_Rregression": 300, "S3M_minimum_dN_for_Updating": 20,
            "S3M_R2_min": 0.2, "S3M_R2_high_elev": 0.6, "S3M_Thresh_high_elev": 2500,
            "S3M_Updating_coeff_corr_Combin": 1, "S3M_Corr_z_Updating": [2000, 4500]
          }
        ]
    }
  },
  "log": {
    "path": "{path_log}/{domain_name}", "file_name": "converter_point2grid_snow_height.txt",
    "handlers": ["file","stream"]
  },
  "tmp": {
    "path": "{path_tmp}/{domain_name}",
    "file_name": null
  }
}
