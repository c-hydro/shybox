{
  "__comment__": "configuration file for the datasets information",
  "configuration": {
    "priority": {
      "reference": "environment", "other": "user"
    },
    "flags": {
      "update_namelist": true, "update_execution": true
    },
    "variables": {
      "lut": {
        "user": {
          "path_time_source": null, "path_time_destination": null,
          "time_rounding": "H", "time_frequency": "H",  "time_direction": "forward",
          "time_start_rounding": "H", "time_end_rounding": "H",
          "file_log": "{execution_name}_{domain_name}.log",
          "execution_name": "converter_points2grid", "execution_mode": "history"
        },
        "environment": {
          "domain_name": "DOMAIN_NAME",
          "path_geo": "PATH_GEO",
          "path_dynamic_source": "PATH_SRC", "path_dynamic_destination": "PATH_DST",
          "file_time_source_ground": "TIME_RUN", "file_time_source_srt": "TIME_RUN",
          "file_time_destination": "TIME_RUN",
          "time_run": "TIME_RUN", "time_period" : "TIME_PERIOD",
          "time_start": "TIME_START", "time_end": "TIME_END",
          "path_app": "PATH_APP",
          "path_log": "PATH_LOG", "path_tmp": "PATH_TMP"
        }
      },
      "format": {
        "domain_name": "string",
        "path_geo": "string",
        "path_dynamic_source": "string", "path_dynamic_destination": "string",
        "path_time_source": "string", "path_time_destination": "string",
        "file_time_source_ground": "timestamp",  "file_time_source_srt": "timestamp",
        "file_time_destination": "timestamp",
        "time_direction": "string", "time_run": "string",
        "time_start": "string", "time_end": "string",
        "time_period": "int", "time_rounding": "string", "time_frequency": "string",
        "time_start_rounding": "string", "time_end_rounding": "string",
        "path_app": "string",
        "path_log": "string", "file_log": "string",
        "path_tmp": "string",
        "execution_name": "string", "execution_mode": "string"
      },
      "template": {
        "domain_name": "string",
        "path_geo": "string",
        "path_dynamic_source": "string", "path_dynamic_destination": "string",
        "path_time_source": "", "path_time_destination": "%Y/%m/%d/",
        "file_time_source_ground": "%Y%m%d_%H%M", "file_time_source_srt": "%Y%m%d%H%M",
        "file_time_destination": "%Y%m%d%H%M",
        "time_direction": "string", "time_run": "%Y%m%d%H00",
        "time_start": "%Y%m%d%H00", "time_end": "%Y%m%d%H00",
        "time_period": "int", "time_rounding": "string", "time_frequency": "string",
        "time_start_rounding": "string", "time_end_rounding": "string",
        "path_app": "string",
        "path_log": "string", "file_log": "string",
        "path_tmp": "string",
        "execution_name": "string", "execution_mode": "string"
      }
    }
  },
  "application": {
    "time": {
      "start": "{time_start}",
      "end": "{time_end}",
      "frequency": "H",
      "format": "%Y-%m-%d %H:%M",
      "analysis": "{time_period}",
      "dataset": "{time_period}"
    },
    "static_data": {
      "raster_terrain": {
        "path": "{path_geo}/",
        "file_name": "vda.dem.txt"
      }
    },
    "dynamic_data_src": {
      "ground": {
        "path": "{path_dynamic_source}/ground/{path_time_source}/",
        "file_name": "raingauge_cell_value_{file_time_source_ground}.txt",
        "format": "ascii"
      },
      "srt": {
        "path": "{path_dynamic_source}/srt/{path_time_source}/",
        "file_name": "SRT1_{file_time_source_srt}.tif",
        "format": "tiff"
      }
    },
    "dynamic_data_dst": {
      "path": "{path_dynamic_destination}/{path_time_destination}/",
      "file_name": "griso_fixed_{file_time_destination}.tif",
      "format": "geotiff", "type": "default"
    }
  },
  "workflow": {
    "options": {
        "intermediate_output": "Tmp",
        "tmp_dir": "{path_tmp}",
        "io_config": {"mode": "one_data_to_one_file"}
    },
    "process_list": {
        "RAIN_WORKFLOW": [
          {
            "function": "exec_interpolate_points_rain",
            "datasets": {"data": "rain", "grid": "srt"},
            "results": {"precipit": "rain"},
            "args": {
              "fill_value": -9999,
              "station_no_data": -9999, "background_no_data": -9999,
              "radius_km": 30, "correlation": "fixed",
              "frequency": "1h", "steps": 1, "direction": "backward"
            }
          }
        ]
    }
  },
  "log": {
    "path": "{path_log}/{domain_name}", "file_name": "converter_point2grid_rain.txt",
    "handlers": ["file","stream"]
  },
  "tmp": {
    "path": "{path_tmp}/{domain_name}",
    "file_name": null
  }
}
